<header class="jumbotron grey lighten-4">
    <h1>Object Explorer</h1>
    <p class="lead"></p>
</header>

<div class="container-fluid p-4">
     <h2><u>{{object.title}}</u></h2>

    <dl class="row pb-3">
        {{#if object.objectnumber}}
        <dt class="col-sm-3">Object Number</dt>
        <dd class="col-sm-9">{{object.objectnumber}}</dd>
        {{/if}}
        {{#if object.classification}}
        <dt class="col-sm-3">Classification</dt>
        <dd class="col-sm-9">{{object.classification}}</dd>
        {{/if}}
        {{#if object.worktypes}}
        <dt class="col-sm-3">Work Types</dt>
        <dd class="col-sm-9">{{#object.worktypes}}{{worktype}}{{#unless @last}}, {{/unless}}{{/object.worktypes}}</dd>
        {{/if}}
        {{#if object.dated}}
        <dt class="col-sm-3">Date</dt>
        <dd class="col-sm-9">{{object.dated}}<span id="object-age"></span></dd>
        {{/if}}
        {{#if object.period}}
        <dt class="col-sm-3">Period</dt>
        <dd class="col-sm-9">{{object.period}}</dd>
        {{/if}}
        {{#if object.century}}
        <dt class="col-sm-3">Century</dt>
        <dd class="col-sm-9">{{object.century}}</dd>
        {{/if}}
        {{#if object.culture}}
        <dt class="col-sm-3">Culture</dt>
        <dd class="col-sm-9">{{object.culture}}</dd>
        {{/if}}
        {{#if object.medium}}
        <dt class="col-sm-3">Medium</dt>
        <dd class="col-sm-9">{{object.medium}}</dd>
        {{/if}}
        {{#if object.technique}}
        <dt class="col-sm-3">Technique</dt>
        <dd class="col-sm-9">{{object.technique}}</dd>
        {{/if}}
        {{#if object.terms.support}}
        <dt class="col-sm-3">Supports</dt>
        <dd class="col-sm-9">{{#object.terms.support}}{{name}}{{#unless @last}}, {{/unless}}{{/object.terms.support}}</dd>
        {{/if}}
        {{#if object.dimensions}}
        <dt class="col-sm-3">Dimensions</dt>
        <dd class="col-sm-9">{{object.dimensions}}</dd>
        {{/if}}
        {{#if object.creditline}}
        <dt class="col-sm-3">Credit Line</dt>
        <dd class="col-sm-9">{{object.creditline}}</dd>
        {{/if}}
        {{#if object.accessionyear}}
        <dt class="col-sm-3">Accession Year</dt>
        <dd class="col-sm-9">
            {{object.accessionyear}}
            <span id="acquisition-gap"></span>
        </dd>
        {{/if}}
    </dl>

    {{#if object.people}}
    <div class="pb-3">
    <h3>People</h3>
    {{#object.people}}
        <p>{{role}}: <a href="/people/{{personid}}" target="_blank">{{displayname}}</a></p>
    {{/object.people}}
    </div>
    {{/if}}
    
    {{#if object.provenance}}
    <h3>Provenance</h3>
    <div class="pb-3">{{{object.provenance}}}</div>
    {{/if}}

    {{#if object.description}}
    <h3>Description</h3>
    <div class="pb-3">{{{object.description}}}</div>
    {{/if}}

    {{#if object.commentary}}
    <h3>Commentary</h3>
    <div class="pb-3">{{{object.commentary}}}</div>
    {{/if}}

    {{#if object.labeltext}}
    <h3>Label Text</h3>
    <div class="pb-3">{{{object.labeltext}}}</div>
    {{/if}}
    
    <hr>

    {{#if object.gradient}}
    <h3>Colors</h3>
    <div class="pb-4">
        <div style="background: {{{object.gradient}}}; height: 40px; border-radius: 4px;" title="Color gradient"></div>
        <div class="d-flex flex-wrap pt-2">
        {{#object.colors}}
            <div class="me-2 mb-2 text-center" style="width: 48px;">
                <div style="background-color: {{color}}; width: 48px; height: 48px; border-radius: 4px; border: 1px solid #ccc;"></div>
                <small>{{color}}</small>
            </div>
        {{/object.colors}}
        </div>
    </div>
    {{/if}}

    <hr>

    <h3>Images</h3>
    <div class="row pb-4">
    {{#object.images}}
        <div class="col-6 col-md-4 col-lg-3 mb-4">
            <div class="card h-100">
                <img src="{{iiifbaseuri}}/full/!400,400/0/default.jpg" class="card-img-top" alt="{{alttext}}">
                <div class="card-body p-2">
                    {{#if alttext}}<p class="card-text small mb-1">{{alttext}}</p>{{/if}}
                    {{#if description}}<p class="card-text small text-muted">{{description}}</p>{{/if}}
                </div>
            </div>
        </div>
    {{/object.images}}
    </div>

    <h3>Activity</h3>
    <div class="pb-4">
        <div id="activity-graph" class="graph pb-3"></div>
        <div id="activity-day-data">
            <div class="d-flex"><span class="w-50">Period of activity:</span><span class="metric-period"></span></div>
            <div class="d-flex"><span class="w-50">Total page views:</span><span class="metric-pageviews">0</span></div>
            <div class="d-flex"><span class="w-50">Unique page views:</span><span class="metric-uniquepageviews">0</span></div>
            <div class="d-flex"><span class="w-50">Physical moves:</span><span class="metric-moves">0</span></div>
            <div class="d-flex"><span class="w-50">Record edits:</span><span class="metric-edits">0</span></div>
            <div class="d-flex"><span class="w-50">Study center views:</span><span class="metric-studycenterviews">0</span></div>
            <div class="d-flex"><span class="w-50">Conservation:</span><span class="metric-conservation">0</span></div>
        </div>
    </div>

    <hr>

    <div id="object-timeline-section" class="pb-4">
        <h3>Timeline</h3>
        <div id="object-timeline-embed" style="height: 600px; overflow: unset;"></div>
    </div>

</div>

<link title="timeline-styles" rel="stylesheet" href="//cdn.knightlab.com/libs/timeline3/latest/css/timeline.css">
<script src="//cdn.knightlab.com/libs/timeline3/latest/js/timeline.js"></script>
<script src="https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js"></script>
<script src="/javascripts/activity-graph.js"></script>
<script>
	const graphContainer = document.getElementById('activity-graph');
    const dataContainer  = document.getElementById('activity-day-data');
	makeActivityGraph({{object.id}}, graphContainer, dataContainer);
</script>

<script>
(function() {
    const accessionYear = {{#if object.accessionyear}}{{object.accessionyear}}{{else}}null{{/if}};
    const beginDate     = {{#if object.datebegin}}{{object.datebegin}}{{else}}null{{/if}};
    const endDate       = {{#if object.dateend}}{{object.dateend}}{{else}}null{{/if}};
    const currentYear   = new Date().getFullYear();

    // --- Object age ---
    const ageEl = document.getElementById('object-age');
    if (ageEl && (beginDate || endDate)) {
        if (beginDate && endDate && beginDate !== endDate) {
            const mid = Math.round((beginDate + endDate) / 2);
            const age = currentYear - mid;
            const spread = Math.abs(endDate - beginDate);
            const qualifier = spread > 100 ? 'roughly ' : 'approximately ';
            if (age > 0) {
                ageEl.textContent = ` — ${qualifier}${age} years old`;
            }
        } else {
            const createdYear = beginDate || endDate;
            const age = currentYear - createdYear;
            if (age > 0) {
                ageEl.textContent = ` — ${age} year${age !== 1 ? 's' : ''} old`;
            } else if (age === 0) {
                ageEl.textContent = ` — created this year`;
            }
        }
    }

    // --- Acquisition gap ---
    const gapEl = document.getElementById('acquisition-gap');
    if (!gapEl || !accessionYear || (!beginDate && !endDate)) return;

    if (beginDate && endDate && beginDate !== endDate) {
        // It's a date range — use the midpoint and be fuzzy
        const mid = Math.round((beginDate + endDate) / 2);
        const gap = accessionYear - mid;
        if (gap > 0) {
            const spread = Math.abs(endDate - beginDate);
            let qualifier = spread > 100 ? 'roughly ' : 'approximately ';
            gapEl.textContent = ` — The museum acquired this object ${qualifier}${gap} years after it was created.`;
        }
    } else {
        // Single date — be precise
        const createdYear = beginDate || endDate;
        const gap = accessionYear - createdYear;
        if (gap > 0) {
            gapEl.textContent = ` — The museum acquired this object ${gap} year${gap !== 1 ? 's' : ''} after it was created.`;
        } else if (gap === 0) {
            gapEl.textContent = ` — The museum acquired this object in the same year it was created.`;
        }
    }
})();
</script>

<script>
(async function () {
    try {
        const response = await fetch('/objects/{{object.id}}/timeline');
        const events = await response.json();

        if (events.length > 0) {
            new TL.Timeline('object-timeline-embed', { events: events }, { timenav_height_percentage: 40, hash_bookmark: false });
        } else {
            document.getElementById('object-timeline-section').style.display = 'none';
        }
    } catch (err) {
        console.error('Failed to load object timeline:', err);
        document.getElementById('object-timeline-section').style.display = 'none';
    }
})();
</script>
