<header class="jumbotron grey lighten-4">
    <h1>The Ancients</h1>
    <p class="lead">Department of Ancient and Byzantine Art &amp; Numismatics </p>
</header>

<section>
    <div class="container-fluid pb-5 pl-5">

        <h2>By the Numbers</h2>            
        {{objects.info.totalrecordsString}} items in the department

        <details>
            <summary>Classifications</summary>
            <ul>
            {{#each objects.aggregations.by_classification.buckets}}
                <li>{{doc_count}} {{key}}</li> 
            {{/each}}
            </ul>        
        </details>

        <details>
            <summary>Page Views</summary>
            <ul>
            {{#each objects.aggregations.by_pageviews.buckets}}
                <li>{{@key}}: {{doc_count}} </li> 
            {{/each}}
            </ul>        
        </details>        

        <details>
            <summary>Exhibition History</summary>
            <ul>
            {{#each objects.aggregations.by_exhibitioncount.buckets}}
                <li>{{@key}}: {{doc_count}} </li> 
            {{/each}}
            </ul>        
        </details>

        <details>
            <summary>Things Currently On View</summary>
            <ul>
            {{#each objects.aggregations.by_floor.buckets}}
                <li>{{doc_count}} items on floor {{key}}</li> 
            {{/each}}
            </ul>  
        </details>

        <hr>

        <h2>A Random Selection of Items</h2>
        <div>
        {{#each objects.records}}
            <a href="{{url}}" target="_blank">
            <img src="{{primaryimageurl}}" style="width:150px;height:150px;overflow:hidden;">
            {{!-- <img src="{{images.[0].baseimageurl}}:IMAGE/square/100,/0/default.jpg"> --}}
            </a>
        {{/each}}
        </div>

    </div>
</section>

<footer class="page-footer grey darken-1 font-small p-3">
    <div class="container-responsive text-left">
    	Another R&amp;D project from the department of Digital Infrastructure and Emerging Technology at <a href="https://hvrd.art">Harvard Art Museums</a>
    </div>
</footer>

