<header class="jumbotron grey lighten-4">
    <h1>Archives Scrapbooks</h1>
    <p class="lead">Ctrl-C, Ctrl-V. Rinse, repeat.</p>
</header>

<div class="container">
    <h2>{{data.title}}, {{data.dated}}</h2>
    <div class="mb-1">{{data.objectnumber}}</div>
    <div class="mb-4"><a target="_blank" href="https://iiif.harvardartmuseums.org/viewers/mirador/v2?manifest=https://iiif.harvardartmuseums.org/manifests/object/{{data.id}}">View in Mirador</a></div>
    {{#data.images}}
        <a href="{{../data.objectid}}/page/{{imageid}}"><img src="{{baseimageurl}}:IMAGE/full/!200,200/0/default.jpg"></a>
    {{/data.images}}
</div>

<footer class="page-footer grey darken-1 font-small p-3 mt-4">
	<div class="container-responsive text-left">
			Another R&amp;D project from the department of Digital Infrastructure and Emerging Technology at Harvard Art Museums
	</div>	
</footer>