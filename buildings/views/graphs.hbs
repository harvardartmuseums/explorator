<script src="https://d3js.org/d3.v5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/d3-array@3"></script>
<script src="https://cdn.jsdelivr.net/npm/d3-color@3"></script>
<script src="https://cdn.jsdelivr.net/npm/d3-format@3"></script>
<script src="https://cdn.jsdelivr.net/npm/d3-interpolate@3"></script>
<script src="https://cdn.jsdelivr.net/npm/d3-time@3"></script>
<script src="https://cdn.jsdelivr.net/npm/d3-time-format@4"></script>
<script src="https://cdn.jsdelivr.net/npm/d3-scale@4"></script>

<style>
	#filterBar select option:disabled {
		color: #bbb;
		font-style: italic;
	}
</style>

<header class="jumbotron grey lighten-4">
    <h1>Building Explorer</h1>
    <p class="lead">Stay awhile. Stay forever.</p>
</header>

<section x-data="dataviz" class="m-2">            
    <div x-show="isLoading" x-text="statusMessage" class="h2"></div>
	<div x-show="!isLoading" id="filterBar">
		<label>Show me a </label>
		<select x-model="layoutType" x-on:change="layout">
			<option value="floor plan">floor plan</option>
			<option value="pack">pack graph</option>
			<option value="tree">tree</option>
		</select>
		view of 
		<select x-model="filterSelection.ownershipStatus" x-on:change="filter">
			<template x-for="opt in filters.ownershipStatuses">
				<option :value="opt.value" :disabled="opt.disabled" x-text="opt.label"></option>
			</template>
		</select>
		<label>classified as </label>
		<select x-model="filterSelection.classification" x-on:change="filter">
			<option value="">anything</option>
			<template x-for="classification in filters.classifications" >
				<option :value="classification.name" :disabled="classification.disabled" :selected="classification.name === filterSelection.classification" :style="`color: ${colors(classification.name)}`" x-text="`● ${classification.name} (${classification.count})`"></option>
    		</template>
		</select>
		<label>installed during the past</label>
		<select x-model="filterSelection.age" x-on:change="filter">
			<template x-for="opt in filters.ages">
				<option :value="opt.value" :disabled="opt.disabled" x-text="opt.label"></option>
			</template>
		</select>
	</div>
	<div x-show="!isLoading" id="objectCount" class="text-muted" x-text="objectCountMessage"></div>
	<div class="d-flex">
    	<div x-show="!isLoading" id="museum"></div>
		<div x-show="!isLoading" id="info" class="p-2" style="max-width:250px"></div>
	</div>
	<div x-show="!isLoading" id="popup" class="position-absolute bg-warning p-2" style="visibility: hidden;"></div>
</section>

<footer class="page-footer grey darken-1 font-small p-3">
    <div class="container-responsive text-left">This page shows a near realtime view of the <span id="numofobjectsonview"></span> objects currently on view in the Harvard Art Museums.</div>
</footer>

<script>
	let popup = d3.select("#popup");

    document.addEventListener('alpine:init', () => {
        Alpine.data('dataviz', () => ({    
            museum: {
				"name": "Harvard Art Museums", 
				"totalobjectssonview": 0,
				"children": [
					{"name": "Lower Level", "floor": 0},
					{"name": "Level 1", "floor": 1},
					{"name": "Level 2", "floor": 2},
					{"name": "Level 3", "floor": 3},
					{"name": "Level 4", "floor": 4},
					{"name": "Level 5", "floor": 5}
				]},
			filters: {
				classifications: [],
				ownershipStatuses: [
					{value: "", label: "all art", disabled: false},
					{value: "loan", label: "loaned art", disabled: false},
					{value: "permanent collection", label: "permanent collection", disabled: false}
				],
				ages: [
					{value: "9999999", label: "anytime", disabled: false},
					{value: "5", label: "5 days", disabled: false},
					{value: "30", label: "30 days", disabled: false},
					{value: "60", label: "60 days", disabled: false},
					{value: "90", label: "90 days", disabled: false},
					{value: "180", label: "6 months", disabled: false},
					{value: "365", label: "1 year", disabled: false},
					{value: "730", label: "2 years", disabled: false},
					{value: "1825", label: "5 years", disabled: false}
				]
			},
			colors: d3.scaleOrdinal([
				"#1f77b4", "#ff7f0e", "#2ca02c", "#d62728", "#9467bd",
				"#8c564b", "#e377c2", "#7f7f7f", "#bcbd22", "#17becf",
				"#aec7e8", "#ffbb78", "#98df8a", "#ff9896", "#c5b0d5",
				"#c49c94", "#f7b6d2", "#c7c7c7", "#dbdb8d", "#9edae5",
				"#393b79", "#5254a3", "#6b6ecf", "#9c9ede", "#637939",
				"#8ca252", "#b5cf6b", "#cedb9c", "#8c6d31", "#bd9e39",
				"#e7ba52", "#e7cb94", "#843c39", "#ad494a", "#d6616b",
				"#e7969c", "#7b4173", "#a55194", "#ce6dbd", "#de9ed6",
				"#3182bd", "#6baed6", "#9ecae1", "#c6dbef", "#e6550d",
				"#fd8d3c", "#fdae6b", "#fdd0a2", "#31a354", "#74c476",
				"#a1d99b", "#c7e9c0", "#756bb1", "#9e9ac8", "#bcbddc",
				"#dadaeb", "#636363", "#969696", "#bdbdbd", "#d9d9d9",
				"#b33dc6", "#27aeef", "#ef5675", "#f9c80e", "#ea7317",
				"#0f4c5c", "#5f0f40", "#9a031e", "#fb8b24", "#e36414",
				"#0d3b66", "#faf0ca", "#f4d35e", "#ee964b", "#f95738"
			]),
			allObjects: [],
			filterSelection: {ownershipStatus: "", "classification": "", "age": 9999999},
            isLoading: false,
            statusMessage: 'Loading...',
            layoutType: '',
			objectCountMessage: '',
			margin: {top: 50, right: 120, bottom: 50, left: 160},
			width: 0,
			height: 0,

            async init() {
				this.width = window.innerWidth - this.margin.right - this.margin.left;
				this.height = window.innerHeight - this.margin.top - this.margin.bottom;

                this.isLoading = true;
                
				await this.buildFilters();

                let baseURL = '/data/galleries?size=100&sort=gallerynumber';

				for (let level of this.museum.children) {
					this.statusMessage = `Building ${level.name}`;
					
					// fetch the list of rooms
					let rooms = await fetch(`${baseURL}&floor=${level.floor}`);
                    rooms = await rooms.json();

					// fetch the list of objects for each room
                	rooms.records.forEach(this.prepareRoom);
                	level.children = rooms.records;

					level.svg = await d3.xml(`/buildings/images/floor-${level.floor}.svg`);
				}

				this.allObjects = [];
				for (let level of this.museum.children) {
					for (let room of (level.children || [])) {
						for (let obj of (room.children || [])) {
							if (obj.objectid) this.allObjects.push(obj);
						}
					}
				}

				this.museum.totalobjectssonview = await this.getObjectCount();
				d3.select("#numofobjectsonview").text(this.museum.totalobjectssonview);

                this.isLoading = false;

				this.layout();
				this.showSummary();
            },

			async getObjectCount() {
                let baseURL = '/data/objects';
                let urlParameters = new URLSearchParams({
                                            size: 0,
                                            gallery: 'any',  
                                        });				

                let art = await fetch(`${baseURL}?${urlParameters.toString()}`);
                    art = await art.json();
                return art.info.totalrecords;	
			},

			async buildFilters() {
				let baseURL = '/data/objects';
				let aggs = {
					"by_classification": {
						"terms": {
							"field": "classification.exact",
							"size": 200, 
							"order": { "_key": "asc" }
						}
					},
					"by_division": { 
						"terms": { 
							"field": "division"
						}
					},
					"by_gender": {
						"terms": {
							"field": "people.gender"
						}
					}
				};
				let urlParameters = new URLSearchParams({
										size: 0,
										gallery: 'any',
										aggregation: JSON.stringify(aggs)
				});

				let data = await fetch(`${baseURL}?${urlParameters.toString()}`).then(r => r.json());	

				data.aggregations.by_classification.buckets.forEach(d => {
					this.filters.classifications.push({name: d.key, count: d.doc_count, disabled: false});
					this.colors(d.key);
				});
			},

            async prepareRoom(d) {
                let baseURL = '/data/objects';
                let fields = 'objectnumber,objectid,title,dated,url,primaryimageurl,classification,classificationid,gallery,rank,totalpageviews,creditline';
                let page = 1;
                let totalPages = 1;
                d.children = [];

                while (page <= totalPages) {
                    let urlParameters = new URLSearchParams({
                                                size: 100,
                                                page: page,
                                                gallery: d.gallerynumber,
                                                sort: 'gallery.gallerynumber',
                                                fields: fields
                                            });

                    let art = await fetch(`${baseURL}?${urlParameters.toString()}`);
                        art = await art.json();
                    d.objectcount = art.info.totalrecords;
                    totalPages = art.info.pages;

                    d.children = d.children.concat(art.records);
                    page++;
                }

                for (var i = d.children.length - 1; i >= 0; i--) {
                    dt1 = new Date(d.children[i].gallery.begindate);
                    dt2 = new Date();
                    var age = Math.floor((Date.UTC(dt2.getFullYear(), dt2.getMonth(), dt2.getDate()) - Date.UTC(dt1.getFullYear(), dt1.getMonth(), dt1.getDate()) ) /(1000 * 60 * 60 * 24));
                    d.children[i].gallery.age = age;
					d.children[i].name = d.children[i].title;

					d.children[i].ownershipStatus = d.children[i].objectnumber.startsWith("TL") ? "loan" : "permanent collection";
                }

                if (d.id) {
                    delete d.id;
                }
            },

			filter(e) {
				this.updateAvailableOptions();

				d3.selectAll("#museum circle.object, #museum text.object")
					.style("opacity", 1.0)
					.filter(this.isNotInSelection.bind(this))
						.style("opacity", 0.1);
				let all = d3.selectAll("#museum circle.object").filter(d => d.data.objectid);
				let total = this.museum.totalobjectssonview;
				let visible = all.filter(d => !this.isNotInSelection(d)).size();
				this.objectCountMessage = `Showing ${visible} of ${total} objects`;
				this.updateFilterMessage(total, visible);
			},

			updateAvailableOptions() {
				let currentOwnership = this.filterSelection.ownershipStatus;
				let currentClassification = this.filterSelection.classification;
				let currentAge = parseInt(this.filterSelection.age);

				this.filters.classifications = this.filters.classifications.map(cls => ({
					...cls,
					disabled: cls.name === currentClassification ? false : !this.allObjects.some(obj =>
						obj.classification === cls.name &&
						(currentOwnership === "" || obj.ownershipStatus === currentOwnership) &&
						obj.gallery && obj.gallery.age <= currentAge
					)
				}));

				this.filters.ownershipStatuses = this.filters.ownershipStatuses.map(opt => ({
					...opt,
					disabled: (opt.value === "" || opt.value === currentOwnership) ? false : !this.allObjects.some(obj =>
						obj.ownershipStatus === opt.value &&
						(currentClassification === "" || obj.classification === currentClassification) &&
						obj.gallery && obj.gallery.age <= currentAge
					)
				}));

				this.filters.ages = this.filters.ages.map(opt => ({
					...opt,
					disabled: (opt.value === "9999999" || parseInt(opt.value) == currentAge) ? false : !this.allObjects.some(obj =>
						obj.gallery && obj.gallery.age <= parseInt(opt.value) &&
						(currentOwnership === "" || obj.ownershipStatus === currentOwnership) &&
						(currentClassification === "" || obj.classification === currentClassification)
					)
				}));
			},

			updateFilterMessage(total, visible) {
				d3.select("#info").selectAll(".filter-message").remove();

				let isFiltered = this.filterSelection.age != 9999999 ||
					this.filterSelection.classification !== "" ||
					this.filterSelection.ownershipStatus !== "";

				if (!isFiltered) return;

				let messages = [];

				if (this.filterSelection.age != 9999999) {
					let days = parseInt(this.filterSelection.age);
					let label = days < 365 ? `${days} days` : `${days / 365} year${days / 365 > 1 ? 's' : ''}`;
					let changed = total - visible;
					let changedPct = Math.round((changed / total) * 100);
					messages.push(`${visible} objects were installed in the past ${label}.`);
					if (visible > 0) {
						messages.push(`Roughly ${Math.round((visible / total) * 100)}% of objects in the museum has changed since then.`);
					} else {
						messages.push(`Nothing has changed in ${label}.`);
					}
				}

				let totalGalleries = new Set(this.allObjects.map(obj => obj.gallery.gallerynumber)).size;
				let activeGalleries = new Set(
					this.allObjects
						.filter(obj => !this.isObjectFiltered(obj))
						.map(obj => obj.gallery.gallerynumber)
				).size;
				let galleryPct = Math.round((activeGalleries / totalGalleries) * 100);
				messages.push(`About ${activeGalleries} galleries contain these items. That's roughly ${galleryPct}% of galleries.`);

				let info = d3.select("#info")
					.insert("div", ":first-child")
					.attr("class", "filter-message alert alert-info");
				messages.forEach(m => info.append("p").attr("class", "mb-1").text(m));
			},

			isObjectFiltered(obj) {
				if (obj.gallery.age > parseInt(this.filterSelection.age)) return true;
				if (this.filterSelection.classification !== "" && obj.classification !== this.filterSelection.classification) return true;
				if (this.filterSelection.ownershipStatus !== "" && obj.ownershipStatus !== this.filterSelection.ownershipStatus) return true;
				return false;
			},

			showSummary() {
				let totalGalleries = new Set(this.allObjects.map(obj => obj.gallery.gallerynumber)).size;
				let totalArtworks = this.allObjects.length;
				let loanCount = this.allObjects.filter(obj => obj.ownershipStatus === 'loan').length;
				let pctLoan = Math.round((loanCount / totalArtworks) * 100);
				let loanGalleries = new Set(this.allObjects.filter(obj => obj.ownershipStatus === 'loan').map(obj => obj.gallery.gallerynumber)).size;
				let stale = this.allObjects.filter(obj => obj.gallery.age > 3650).length;
				let pctStale = Math.round((stale / totalArtworks) * 100);

				let newest = this.allObjects.reduce((min, obj) => obj.gallery.age < min.gallery.age ? obj : min, this.allObjects[0]);
				let newestAge = newest.gallery.age;
				let newestGalleries = [...new Set(
					this.allObjects
						.filter(obj => obj.gallery.age === newestAge)
						.map(obj => obj.gallery.gallerynumber)
				)];

				let installDate = new Date();
				installDate.setDate(installDate.getDate() - newestAge);
				let dateStr = installDate.toLocaleDateString('en-US', {year: 'numeric', month: 'long', day: 'numeric'});

				let info = d3.select("#info")
					.append("div")
					.attr("class", "summary-message alert alert-secondary");

				info.append("p").attr("class", "mb-1").text(`There are ${totalGalleries} galleries.`);
				info.append("p").attr("class", "mb-1").text(`There are ${totalArtworks} artworks in these galleries.`);
				info.append("p").attr("class", "mb-1").text(`${loanCount} of these artworks are loans. That's about ${pctLoan}% of the collections on display. They are spread across ${loanGalleries} galleries.`);
				info.append("p").attr("class", "mb-1").text(`${stale} artworks haven't moved in over 10 years. That's about ${pctStale}% of the collections in the galleries.`);

				let galleryObjects = {};
				this.allObjects.forEach(obj => {
					let g = obj.gallery.gallerynumber;
					if (!galleryObjects[g]) galleryObjects[g] = [];
					galleryObjects[g].push(obj);
				});
				let staticGalleries = Object.entries(galleryObjects).filter(([g, objs]) => {
					let staleCount = objs.filter(o => o.gallery.age >= 3650).length;
					return staleCount > objs.length / 2;
				}).map(([g]) => g);
				info.append("p").attr("class", "mb-1").text(`${staticGalleries.length} galleries are mostly static (majority of objects haven't moved in 10+ years): ${staticGalleries.join(', ')}.`);

				info.append("p").attr("class", "mb-1").text(`The most recent install was ${dateStr} in ${newestGalleries.length > 1 ? 'galleries' : 'gallery'} ${newestGalleries.join(', ')}.`);
			},

			async layout(e) {
				d3.select("#museum")
					.selectAll("*").remove();
					
				// toggle visibility to prevent flickering
				d3.select("#museum")					
					.style("visibility", "hidden");
				
				if (this.layoutType === "pack") {
					await this.packLayout();
				} else if (this.layoutType === "tree") {
					await this.treeLayout();
				} else {
					await this.floorplanLayout();
				}
				this.filter();

				d3.select("#museum")
					.style("visibility", "visible");
			},

			isNotInSelection(record) {
				let output = false;
				if (record.data.gallery) {
					if ((record.data.gallery.age > this.filterSelection.age)) {
						output = true;
					}
					if (this.filterSelection.classification !== "") {
						if (record.data.classification != this.filterSelection.classification) {
							output = true;
						}
					}
					if (this.filterSelection.ownershipStatus !== "") {
						if (record.data.ownershipStatus != this.filterSelection.ownershipStatus) {
							output = true;
						}
					}
				}

				return output;
			},

			async floorplanLayout() {
				var w = this.width,
				    h = this.height;

			    let colors = this.colors;

				var node = $.extend(true, {}, this.museum);

				let f1 = await d3.xml("/buildings/images/floor-1.svg");
				populateFloor(f1, node.children[1]);

				let f2 = await d3.xml("/buildings/images/floor-2.svg");
				populateFloor(f2, node.children[2]);
				
				let f3 = await d3.xml("/buildings/images/floor-3.svg");
				populateFloor(f3, node.children[3]);
				
				let f4 = await d3.xml("/buildings/images/floor-4.svg");
				populateFloor(f4, node.children[4]);
				
				let f0 = await d3.xml("/buildings/images/floor-0.svg");
				populateFloor(f0, node.children[0]);

				function populateFloor(map, data) {
					var floor = document.getElementById('museum')
									.appendChild(map.documentElement);
			
					var canvas = d3.select(floor)
						.attr("id", "floor-" + data.floor)
						.attr("width", w/3.1)
				    	.attr("height", h/1.5);

					for (const d of data.children) {
					    var room = d3.select('#rooms path[data-room="' + d.gallerynumber + '"]');	
					    if (!room.empty()) {
							var roomDims = room.node().getBBox();

							var pack = d3.pack()
								.size([roomDims.width, roomDims.height]);

							var root =  d3.hierarchy(d)
							            	.sum(d => d.hasOwnProperty("rank") ? d.objectid : 0)
											.sort((a,b) => b.value - a.value);
							
							var nodes = pack(root);
							
							canvas.selectAll("circles")
									.data(nodes.descendants())
								.enter().append("circle")
									.attr("class", "object")
									.attr('cx', function(d) { return d.x + roomDims.x; })
									.attr('cy', function(d) { return d.y + roomDims.y; })
									.attr('r', function(d) { return d.r; })
									.style('fill',  function(d) { return d.data.classification ? colors(d.data.classification) : "#ffffff"; })
									.on("click", updateInfoPanel)
									.on("mouseover", showInfoPopup)
									.on("mouseout", hideInfoPopup);
						}
				    };
				}	
			},

            async packLayout() {
				//See https://github.com/mbostock/d3/wiki/Pack-Layout
				//See http://mbostock.github.io/d3/talk/20111018/#22
				//http://bl.ocks.org/mbostock/4063530
				//http://bl.ocks.org/mbostock/4063269
	    
				var w = this.width,
				    h = this.height,
				    r = this.height,
				    x = d3.scaleLinear().range([0, r]),
				    y = d3.scaleLinear().range([0, r]),
				    node,
				    root;

			    let colors = this.colors;

				var pack = d3.pack()
				    .size([r, r]);

				var vis = d3.select("#museum").append("svg")
				    .attr("width", w)
				    .attr("height", h)
				    .on("click", function() { zoom(root); })
				  .append("g")
				    .attr("transform", "translate(" + (w - r) / 2 + "," + (h - r) / 2 + ")");

				node = root = d3.hierarchy(JSON.parse(JSON.stringify(this.museum)))
                    .sum(d => 10)
                    .sort((a,b) => b.value - a.value);

				var nodes = pack(root);

				vis.selectAll("circle")
				  .data(nodes.descendants())
				.enter().append("circle")
				  .attr("class", function(d) { return d.children ? "gallery" : "object"; })
				  .attr("cx", function(d) { return d.x; })
				  .attr("cy", function(d) { return d.y; })
				  .attr("r", function(d) { return d.r; })
                  .style("stroke", "#999")
				  .style("fill", function(d) {return d.data.classification ? colors(d.data.classification) : "#ffffff"; })
					.on("click", updateInfoPanel)
					.on("mouseover", showInfoPopup)
					.on("mouseout", hideInfoPopup);
				  {{!-- .on("click", function(d) { return zoom(node == d ? root : d); }) --}}
                

				vis.selectAll("text")
				  .data(nodes.descendants())
				.enter().append("text")
				  .attr("class", function(d) { return d.children ? "parent" : "child"; })	
				  .attr("x", function(d) { return d.x; })
				  .attr("y", function(d) { return d.y; })
				  .attr("dy", ".35em")
				  .attr("text-anchor", "middle")
				  .style("opacity", function(d) { return d.r > 20 ? 1 : 0; })
				  .style("display", function(d) { return d.parent === root ? "inline" : "none"})
				  .text(function(d) { return d.data.gallerynumber ? d.data.name + ' (' + d.data.gallerynumber + ')' : d.data.objectnumber ? d.data.classification : d.data.name; })
				  .on("click", function(d) { return zoom(node == d ? root : d); });

				function zoom(d, i) {
				  var focus = d;

				  //Zoom up until the second last depth
				  if (focus.children) {
					  var k = r / d.r / 2;
					  x.domain([d.x - d.r, d.x + d.r]);
					  y.domain([d.y - d.r, d.y + d.r]);

					  var t = vis.transition()
					      .duration(d3.event.altKey ? 7500 : 750);

					  t.selectAll("circle")
					      .attr("cx", function(d) { return x(d.x); })
					      .attr("cy", function(d) { return y(d.y); })
					      .attr("r", function(d) { return k * d.r; });

					  t.selectAll("circle.child")
					  	  .attr("class", function(d) { return (d.parent ===focus && focus.depth == 2) ? "child on" : "child"; });

					  t.selectAll("text")
					      .attr("x", function(d) { return x(d.x); })
					      .attr("y", function(d) { return y(d.y); })
					      .style("display", function(d) { return d.parent === focus ? "inline" : "none"})
					      .style("opacity", function(d) { return k * d.r > 20 ? 1 : 0; });
				  }

				  //Keep track of the selected node
				  node = d;
				  d3.event.stopPropagation();
				}			
			},

			async treeLayout() {
				const width = this.width;

				// Compute the tree height; this approach will allow the height of the
				// SVG to scale according to the breadth (width) of the tree layout.
				const root = d3.hierarchy(this.museum);
				const dx = 10;
				const dy = width / (root.height + 1);

			    const colors = this.colors;

				// Create a tree layout.
				const tree = d3.tree().nodeSize([dx, dy]);

				// Sort the tree and apply the layout.
				root.sort((a, b) => d3.ascending(a.data.name, b.data.name));
				tree(root);

				// Compute the extent of the tree. Note that x and y are swapped here
				// because in the tree layout, x is the breadth, but when displayed, the
				// tree extends right rather than down.
				let x0 = Infinity;
				let x1 = -x0;
				root.each(d => {
					if (d.x > x1) x1 = d.x;
					if (d.x < x0) x0 = d.x;
				});

				// Compute the adjusted height of the tree.
				const height = x1 - x0 + dx * 2;

				const svg = d3.select("#museum").append("svg")
					.attr("width", width)
					.attr("height", height)
					.attr("viewBox", [-dy / 3, x0 - dx, width, height])
					.attr("style", "max-width: 100%; height: auto; font: 10px sans-serif;");

				const link = svg.append("g")
					.attr("fill", "none")
					.attr("stroke", "#555")
					.attr("stroke-opacity", 0.4)
					.attr("stroke-width", 1.5)
					.selectAll()
					.data(root.links())
					.join("path")
						.attr("d", d3.linkHorizontal()
							.x(d => d.y)
							.y(d => d.x));
				
				const node = svg.append("g")
					.attr("stroke-linejoin", "round")
					.attr("stroke-width", 3)
					.selectAll()
					.data(root.descendants())
					.join("g")
					.attr("transform", d => `translate(${d.y},${d.x})`);

				node.append("circle")
					.attr("class", d => d.children ? "gallery" : "object")
					.attr("fill", d => d.data.classification ? colors(d.data.classification) : "#999")
					.attr("r", 2.5)
					.on("click", updateInfoPanel)
					.on("mouseover", showInfoPopup)
					.on("mouseout", hideInfoPopup);

				node.append("text")
					.attr("dy", "0.31em")
					.attr("x", d => d.children ? -6 : 6)
					.attr("text-anchor", d => d.children ? "end" : "start")
					.text(d => d.data.name)
					.attr("stroke", "white")
					.attr("paint-order", "stroke")
					.attr("class", d => d.children ? "gallery" : "object")
					.on("click", updateInfoPanel)
					.on("mouseover", showInfoPopup)
					.on("mouseout", hideInfoPopup);
			}			   
        }));
    });

	function showInfoPopup(data) {
		let object = data.data;
		if (object.title) {
			d3.select(d3.event.target)
				.style('stroke', '#000000')
				.style('stroke-width', '5');
			
			popup
				.style("top", (d3.event.pageY-20)+"px").style("left",(d3.event.pageX+20)+"px")
				.style("visibility", "visible")
				.html(object.title);
			if (object.primaryimageurl) {
				popup.append("img")
					.attr("class", "p-2")
					.attr("src", object.primaryimageurl + "/full/150,/0/default.jpg");
			}
		}
	}

	function hideInfoPopup(data) {			
		let object = data.data;
		if (object.title) {			
			d3.select(d3.event.target)
					.style('stroke', '')
		}
		popup.style("visibility", "hidden");
	}

	function updateInfoPanel(data) {
		let object = data.data;
		var info = d3.select("#info")
					.insert("div", ":first-child")
					.attr("class", "data-block");

		if (object.primaryimageurl) {
			info.append("img")
				.attr("src", object.primaryimageurl + "/full/100,/0/default.jpg");
		}

		info.append("div")
			.append("a")
			.attr("href", object.url)
			.attr("target", "_blank")
			.text(object.title);

		if (object.dated) {
			info.append("div").text(object.dated);
		}

		info.append("div").text(object.classification);
		info.append("div").text(`On view for ${object.gallery.age} days in room ${object.gallery.gallerynumber}`);
		if (object.ownershipStatus == 'loan') {
			info.append("div").html(`This is on <mark>loan</mark> from ${object.creditline}.`);
		} else {
			info.append("div").text("This part of the permanent collection.");
		}

		info.append("hr");
	}					
</script>